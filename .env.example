# Runtime configuration; copy to .env and keep credentials out of version control.
E2E_OUTPUT_DIR=outputs
E2E_DEVICE=cuda
E2E_MICROBATCH=8
E2E_EFFECTIVE_BATCH=32
E2E_SEED=42
E2E_MAX_HOURS=24
# Optional: existing hf login is also supported. Never log or commit this value.
HF_TOKEN=
# Optional dedicated raw-state storage for the separately registered block-6 sweep (~58 GB).
# E2E_SWEEP_CACHE_DIR=D:/AI/end-to-end-block-sparse-featurizers/downstream-v1
# E2E_SWEEP_ROOT=outputs/sweeps/downstream-v1
# E2E_SWEEP_SOURCE_ROOT=outputs/study
